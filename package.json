{
  "name": "anon-desktop-pet",
  "productName": "Anon Desktop Pet",
  "version": "3.0.0",
  "description": "千早爱音的桌边日常 — Windows companion with optional DeepSeek/Ollama chat and local memory",
  "author": "yokipan77-gif",
  "license": "MIT",
  "main": "src/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/yokipan77-gif/anon-desktop-pet.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "test:art": "node scripts/art-check.cjs",
    "test:windows": "node scripts/window-check.cjs",
    "test:chat": "node scripts/chat-smoke.cjs",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.56.1"
  },
  "build": {
    "appId": "io.github.yokipan77.anonpet",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Anon-Desktop-Pet-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Anon-Desktop-Pet-${version}-Portable.${ext}"
    }
  }
}
